{
  "name": "akvaryum-ureticisi",
  "version": "1.0.0",
  "private": true,
  "description": "Akvaryum Üreticisi — tek dosyalı tarayıcı oyunu ve Capacitor ile Android APK",
  "scripts": {
    "build": "python3 build.py",
    "build:native": "python3 build.py --native",
    "android:add": "cap add android",
    "android:sync": "python3 build.py --native && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@fontsource/baloo-2": "^5.1.0",
    "@fontsource/nunito": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
