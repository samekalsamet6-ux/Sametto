{
  // Cloudflare Workers (statik varlıklar) yapılandırması: Cloudflare panelindeki
  // "Project name" bu ad ile AYNI olmalıdır.
  "name": "lepistes-rehberi",
  "compatibility_date": "2026-10-01",
  "assets": {
    // npm run build çıktısı
    "directory": "./dist",
    // Bulunamayan adreslerde dist/404.html gösterilir
    "not_found_handling": "404-page"
  },
  // Cloudflare'in dal/PR önizleme derlemeleri (`wrangler preview`, açık beta) bu bloğu ister.
  // Boş olabilir; varlıklar ve uyumluluk ayarları yukarıdan devralınır.
  "previews": {}
}
