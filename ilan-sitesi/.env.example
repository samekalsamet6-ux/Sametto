# Yerel geliştirme için örnek ayarlar. Kopyalayın: cp .env.example .env  (.env git'e eklenmez)
PORT=5180
HOST=127.0.0.1
# Bu e-posta ile kayıtlı hesap /admin/raporlar sayfasını görebilir. Boşsa sayfa kimseye açılmaz.
ADMIN_EMAIL=
# Çerezlere Secure bayrağı: https arkasında çalıştırırsanız true yapın (yerel http için false).
COOKIE_SECURE=false
# Veri klasörü (SQLite + yüklenen fotoğraflar). Varsayılan: ./data
DATA_DIR=./data
