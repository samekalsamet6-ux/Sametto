# Yerel geliştirme için örnek ayarlar. Kopyalayın: cp .env.example .env  (.env git'e eklenmez)
PORT=5180
HOST=127.0.0.1
# Yönetici ayarı .env'de DEĞİL: sunucuda `npm run make-admin -- kisi@ornek.com` ile veritabanı bayrağı olarak verilir.
# Ters vekil (nginx vb.) arkasındaysanız true yapın: istemci IP'si X-Forwarded-For'un SON girdisinden okunur. Vekil olmadan true YAPMAYIN (IP sahtelenebilir).
TRUST_PROXY=false
# Çerezlere Secure bayrağı ve HSTS başlığı: https arkasında çalıştırırsanız true yapın (yerel http için false).
COOKIE_SECURE=false
# Veri klasörü (SQLite + yüklenen fotoğraflar). Varsayılan: ./data
DATA_DIR=./data
