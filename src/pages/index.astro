---
import Base from '../layouts/Base.astro';
import { tools } from '../data/araclar';
---
<Base title="Ana Sayfa">
  <section class="hero">
    <h1>Lepistes üretimi için eksiksiz rehber</h1>
    <p class="muted">Yeni başlayanlardan deneyimli yetiştiricilere; rehber, wiki ve yardımcı araçlar tek yerde.</p>
  </section>
  <h2>Nereden başlamalıyım?</h2>
  <div class="grid">
    <a class="card" href="/rehber#baslangic"><span class="badge l-baslangic">🟢</span><h3>Yeni başlıyorum</h3><p class="muted">Kurulum, azot döngüsü, ilk yavrular.</p></a>
    <a class="card" href="/rehber#orta"><span class="badge l-orta">🟡</span><h3>Biraz deneyimim var</h3><p class="muted">Seçilim, beslenme, hastalık önleme.</p></a>
    <a class="card" href="/rehber#ileri"><span class="badge l-ileri">🔴</span><h3>Hat geliştiriyorum</h3><p class="muted">Genetik, inbreeding, pedigri.</p></a>
  </div>
  <h2>Araçlar</h2>
  <div class="grid">
    {tools.slice(0, 6).map((t) => <a class="card" href={`/araclar/${t.slug}`}><h3>{t.title}</h3><p class="muted">{t.desc}</p></a>)}
  </div>
  <p><a href="/araclar">Tüm araçlar →</a></p>
</Base>
