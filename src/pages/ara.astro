---
import Base from '../layouts/Base.astro';
---
<Base title="Ara" description="Rehber ve wiki içinde arama.">
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <h1>Ara</h1>
  <div id="search"></div>
  <p class="muted">Arama dizini yalnızca <code>npm run build</code> sonrasında oluşur (geliştirme sunucusunda boş görünür).</p>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (window.PagefindUI) {
        new PagefindUI({ element: '#search', showSubResults: true, translations: { placeholder: 'Ara: örn. azot döngüsü' } });
        const input = document.querySelector('.pagefind-ui__search-input');
        if (input) input.setAttribute('aria-label', 'Sitede ara');
      }
    });
  </script>
</Base>
