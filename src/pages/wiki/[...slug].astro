---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LevelBadge from '../../components/LevelBadge.astro';
export async function getStaticPaths() {
  const all = await getCollection('wiki');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <p><a href="/wiki">← Wiki</a></p>
  <LevelBadge level={entry.data.level} /> <span class="muted">· {entry.data.category}</span>
  <h1>{entry.data.title}</h1>
  {entry.data.needs_verification && <div class="callout">⚠ Sayısal değerler kaynakla doğrulanmayı bekliyor.</div>}
  <Content />
</Base>
