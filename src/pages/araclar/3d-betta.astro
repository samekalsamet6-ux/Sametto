---
import SpeciesPage from '../../components/SpeciesPage.astro';
import { PARTS } from '../../lib/betta/parts';
import { VARIANTS, groupedVariants } from '../../lib/betta/variants';
import { FORMS } from '../../lib/betta/forms';
import { SEXES, silhouette } from '../../lib/betta/model';
import { svgFigure } from '../../lib/akvaryum/fishmath';

const sexName = { erkek: 'Erkek betta', disi: 'Dişi betta' } as const;
const figures = SEXES.map((s) => ({ label: sexName[s], ...svgFigure(silhouette(s)) }));
const sexes = [
  { id: 'erkek', ad: 'Erkek', not: '' },
  { id: 'disi', ad: 'Dişi', not: '' },
];
const first = groupedVariants();
---
<SpeciesPage
  title="3B betta modeli"
  description="Bettanın (Betta splendens) etkileşimli 3B modeli: labirent organı, yüzgeçler, erkek/dişi farkı, 12 form (plakat, halfmoon, crowntail, fil kulak …) ve renk varyeteleri."
  intro="Betta splendens’in (Siyam dövüşçü balığı) şematik, etkileşimli 3B modeli. Sürükleyerek döndürün, erkek ve dişiyi karşılaştırın, yüzgeç/kuyruk formunu (halfmoon, crowntail, fil kulak …) ve renk varyetelerini birbirinden bağımsız deneyin; numaralı noktalara ya da listeye tıklayıp açıklamaları okuyun."
  views={[{ id: 'yan', ad: 'Yan' }, { id: 'ust', ad: 'Üst' }, { id: 'alt', ad: 'Alt' }, { id: 'on', ad: 'Ön' }, { id: 'arka', ad: 'Arka' }, { id: 'capraz', ad: 'Çapraz' }]}
  sexes={sexes}
  parts={PARTS}
  groups={first}
  variantIntro={`${VARIANTS.length} şematik renk varyetesi; renk ve desen her formla birleşir; yüzgeç ve kuyruk şekli ayrıca “Form” seçicisinden değişir. Ticaret adları standart değildir ve aynı balık farklı satıcılarda farklı adla anılabilir; bu liste resmî bir sınıflama değildir. “Kaynakla doğrulanmalı” işaretli kayıtların adı ya da tanımı belirsizdir.`}
  figures={figures}
  fill="#c2182b"
  forms={FORMS}
  formIntro="Form, yüzgeç ve kuyruk şeklini değiştirir; renk varyetesinden bağımsızdır ve her renk her formla birleşir. Dişilerde süslü formların yüzgeçleri daha kısa ve dardır (şematik). Gerçekte formlar birleşebilir (ör. halfmoon + crowntail, plakat + fil kulak); burada her form tek başına çizilmiştir. Sınıf adları ve açı değerleri kaynaklara göre değişir; “kaynakla doğrulanmalı” işaretli kayıtlar belirsizdir."
  stageLabel="Bettanın etkileşimli 3B modeli."
>
  <div class="callout callout-bilgi" slot="tur">
    <strong>Kapsam.</strong> Bu model <em>Betta splendens</em>’i kısa yüzgeçli standart (“plakat”) formda başlatır; “Form” seçicisiyle veiltail, delta, halfmoon, crowntail, rosetail, çift kuyruk ve fil kulak gibi yetiştirme biçimlerini görebilirsiniz. Model <strong>şematiktir</strong>: oranlar, renkler ve yüzgeç boyutları eğitim amaçlı bir yorumdur; belirli bir bireyin ya da standardın ölçüsü değildir.
  </div>
  <div class="callout callout-uyari" slot="ek" id="safety">
    <strong>Erkekler birbirine saldırgandır.</strong> Erkek bettalar aynı su hacminde birbirini ciddi biçimde yaralayabilir; erkekler ortak tankta tutulmaz. Bu sayfa bakım ya da üretim rehberi değildir (kaynakla doğrulanmalı).
  </div>
  <p class="muted">Modellenmeyenler: boğaz dişleri, iç organlar (labirent organı yalnızca bir nokta olarak anlatılır), form birleşimleri (ör. halfmoon + crowntail), çizgisel solungaç zarı açma hareketi ve yaşa/ruh haline bağlı renk değişimi. Erkek–dişi yüzgeç ve renk farkları şematiktir ve bireyden bireye ve varyeteye göre çok değişir; genç bireylerde ayrım zordur.</p>
  <div class="callout callout-bilgi">
    Aynı serideki diğer modeller: <a href="/araclar/3d-lepistes">3B lepistes</a> ve <a href="/araclar/3d-vatoz">3B cüce vatoz</a>.
  </div>
</SpeciesPage>

<script>
  import { initSpeciesPage } from '../../lib/akvaryum/page';
  import { PARTS, partsFor } from '../../lib/betta/parts';
  import { VARIANTS } from '../../lib/betta/variants';
  import { FORMS } from '../../lib/betta/forms';

  initSpeciesPage({
    parts: PARTS, partsFor, variants: VARIANTS, forms: FORMS, defaultSex: 'erkek', defaultView: 'capraz',
    sexNotes: {
      erkek: 'Erkek: sırt, anal, kuyruk ve karın yüzgeçleri belirgin büyük, renkler canlı çizilmiştir (şematik).',
      disi: 'Dişi: yüzgeçler kısa, renkler soluk, gövde daha dolgun; karın altında yumurta borusu noktası ve soluk dikey şeritler çizilmiştir (şematik). Genç bireylerde ayrım zordur.',
    },
    load: () => import('../../lib/betta/index'),
  });
</script>
