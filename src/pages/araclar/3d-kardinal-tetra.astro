---
import SpeciesPage from '../../components/SpeciesPage.astro';
import { PARTS } from '../../lib/kardinal/parts';
import { FORMS } from '../../lib/kardinal/forms';
import { VARIANTS, groupedVariants } from '../../lib/kardinal/variants';
import { SEXES, FORM_IDS, specFor, silhouette } from '../../lib/kardinal/model';
import { svgFigure } from '../../lib/akvaryum/fishmath';

// WebGL yokken gösterilen SVG yedeği, 3B modelle aynı geometriden türetilir.
const sexName = { erkek: 'Erkek kardinal tetra', disi: 'Dişi kardinal tetra' } as const;
const formName = { standart: 'standart', 'uzun-yuzgec': 'uzun yüzgeçli' } as const;
const figures = FORM_IDS.flatMap((f) => SEXES.map((s) => {
  const sil = silhouette(specFor(f, s));
  const fins = [...sil.fins.map((pts, i) => ({ id: `f${i}`, pts })), { id: 'pec', pts: sil.pectoral }];
  return { label: `${sexName[s]} (${formName[f]})`, ...svgFigure({ body: sil.body, fins, eye: { c: [sil.eye.x, sil.eye.y], r: sil.eye.r } }) };
}));
---
<SpeciesPage
  title="3B kardinal tetra modeli"
  description="Kardinal tetranın (Paracheirodon axelrodi) etkileşimli 3B modeli: gözden yağ yüzgecine mavi-yeşil iridofor şerit, gövdenin tüm boyunca uzanan kırmızı şerit (neon tetradan farkı); standart ve uzun yüzgeçli form; normal, diamond, gold, albino renk hatları."
  intro="Kardinal tetranın (<em>Paracheirodon axelrodi</em>) şematik, etkileşimli 3B modeli. Sürükleyerek döndürün, erkek ve dişiyi karşılaştırın, <strong>Form</strong> ve <strong>Renk</strong> seçicilerini birbirinden bağımsız deneyin; numaralı noktalara ya da listeye tıklayıp açıklamaları okuyun."
  views={[{ id: 'yan', ad: 'Yan' }, { id: 'ust', ad: 'Üst' }, { id: 'on', ad: 'Ön' }, { id: 'arka', ad: 'Arka' }, { id: 'alt', ad: 'Alt' }, { id: 'capraz', ad: 'Çapraz' }]}
  sexes={[{ id: 'erkek', ad: 'Erkek', not: '' }, { id: 'disi', ad: 'Dişi', not: '' }]}
  parts={PARTS}
  forms={FORMS}
  formIntro="İki form gösterilir: doğadaki biçime yakın standart ve tetralarda seçmeli bir hat olarak anlatılan uzun yüzgeçli form (kardinalde yaygınlığı ve adı kaynakla doğrulanmalıdır). Form yalnızca yüzgeç geometrisini değiştirir; her form her renkle birleşir. Başka bir form kaynaklarda net bulunamadığı için eklenmemiştir."
  groups={groupedVariants()}
  variantLabel="Renk / desen"
  variantIntro={`${VARIANTS.length} şematik renk hattı (normal yabani tip, diamond, gold, albino); hepsi aynı gövdeyi paylaşır, yalnızca renk ve desen değişir. Boyanmış, enjekte edilmiş ya da GloFish benzeri floresan balıklar gösterilmez. Ticaret adları standart değildir; “Kaynakla doğrulanmalı” işaretli kayıtların adı ya da varlığı belirsizdir.`}
  figures={figures}
  fill="#d63a40"
  stageLabel="Kardinal tetranın etkileşimli 3B modeli."
>
  <div class="callout callout-bilgi" slot="tur">
    <strong>Kapsam.</strong> Bu model <em>Paracheirodon axelrodi</em> (kardinal tetra) için <strong>şematik</strong> bir gövdedir. Neon tetradan ayırt edici özellik: kırmızı şerit gövdenin <strong>tüm boyunca</strong> (solungaç kapağından kuyruk köküne) uzanır; neonda yalnızca arka yarıdadır. Mavi-yeşil şerit kırmızının üstündedir. Erkek–dişi farkı (dişide biraz daha geniş ve dolgun karın) zayıftır ve doğrulanmalıdır; olgun erkekteki küçük yüzgeç kancaları modellenmemiştir. Boyanmış ya da floresan balıklar kapsam dışıdır. Model bakım, hastalık ya da tedavi rehberi değildir.
  </div>
  <p class="muted" slot="ek">Karın yüzgeçleri bu modelde şematik olarak kısa, tek parça gösterilir; gerçekte ışınlı küçük yelpazelerdir.</p>
  <p class="muted">Modellenmeyenler: pullar tek tek çizilmemiştir (doku olarak vardır), yüzgeç ışınları tek tek hareket etmez, iç organlar ve yüzme kesesi gösterilmemiştir; şeritlerin parıltısı ışığa göre değişen gerçek yapısal rengin yalnızca sabit bir yorumudur, şerit uzunluğu ve kırmızının tonu bireye ve yaban popülasyona göre değişir. Yüzme animasyonu gövdenin yanal dalgalanmasını basitçe taklit eder.</p>
  <div class="callout callout-bilgi">
    Aynı serideki diğer modeller: <a href="/araclar/3d-neon">3B neon tetra</a> (kırmızı yalnızca arka yarıda), <a href="/araclar/3d-zebra-danio">3B zebra danio</a> ve <a href="/araclar/3d-kaplan-barb">3B kaplan barb</a>.
  </div>
</SpeciesPage>

<script>
  import { initSpeciesPage } from '../../lib/akvaryum/page';
  import { PARTS, partsFor } from '../../lib/kardinal/parts';
  import { FORMS } from '../../lib/kardinal/forms';
  import { VARIANTS } from '../../lib/kardinal/variants';

  initSpeciesPage({
    parts: PARTS, partsFor, variants: VARIANTS, forms: FORMS, defaultSex: 'erkek', defaultView: 'capraz',
    sexNotes: {
      erkek: 'Erkek: daha ince ve küçük; mavi şerit daha düz (şematik). Fark zayıftır, gençlerde görülmeyebilir; doğrulanmalı.',
      disi: 'Dişi: biraz daha büyük, geniş ve dolgun karınlı (şematik). Fark zayıftır, gençlerde görülmeyebilir; doğrulanmalı.',
    },
    load: () => import('../../lib/kardinal/index'),
  });
</script>
