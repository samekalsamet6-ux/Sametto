---
import Base from '../../layouts/Base.astro';
import { PARTS, FORM_PARTS } from '../../lib/guppy/parts';
import { FORMS, groupedForms } from '../../lib/guppy/forms';
import { VARIANTS, groupedVariants } from '../../lib/guppy/variants';
import { silhouette, type Sex, type Vec2 } from '../../lib/guppy/model';

// WebGL kullanılamadığında gösterilen statik SVG: 3B modelle aynı sayılardan türetilir.
const poly = (pts: Vec2[]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(3)},${(-y).toFixed(3)}`).join(' ') + ' Z';
const line = (pts: Vec2[]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(3)},${(-y).toFixed(3)}`).join(' ');
const figures = (['erkek', 'disi'] as Sex[]).map((sex) => {
  const s = silhouette(sex);
  const all = [...s.body, ...s.tail, ...s.dorsal, ...s.anal, ...s.gono];
  const xs = all.map((p) => p[0]), ys = all.map((p) => -p[1]);
  const pad = 0.12;
  const x0 = Math.min(...xs) - pad, y0 = Math.min(...ys) - pad;
  return { sex, s, vb: `${x0.toFixed(2)} ${y0.toFixed(2)} ${(Math.max(...xs) - x0 + pad).toFixed(2)} ${(Math.max(...ys) - y0 + pad).toFixed(2)}`, d: {
    body: poly(s.body), tail: poly(s.tail), dorsal: poly(s.dorsal), anal: s.anal.length ? poly(s.anal) : '', pelvic: poly(s.pelvic), pectoral: poly(s.pectoral), gono: s.gono.length ? line(s.gono) : '',
  } };
});
const sexName = { erkek: 'Erkek', disi: 'Dişi' } as const;
---
<Base title="3B lepistes modeli" description="Erkek ve dişi lepistesin etkileşimli 3B modeli: döndürün, yakınlaştırın, renk varyetelerini deneyin ve anatomi parçalarının Türkçe açıklamalarını okuyun.">
  <p><a href="/araclar">← Araçlar</a></p>
  <h1>3B lepistes modeli</h1>
  <p class="muted">Erkek ve dişi lepistesin (<em>Poecilia reticulata</em>) şematik, etkileşimli 3B modeli. Sürükleyerek döndürün, yakınlaştırın, renk varyetelerini deneyin ve numaralı noktalara ya da aşağıdaki listeye tıklayıp parçaların açıklamasını okuyun.</p>

  <div class="g3-bar">
    <fieldset class="g3-seg">
      <legend>Cinsiyet</legend>
      <label><input type="radio" name="sex" value="erkek" checked /> Erkek</label>
      <label><input type="radio" name="sex" value="disi" /> Dişi</label>
    </fieldset>
    <label class="g3-sel">Renk varyetesi
      <select id="variant">{groupedVariants().map((g) => <optgroup label={g.grup}>{g.items.map((v) => <option value={v.id}>{v.ad}</option>)}</optgroup>)}</select>
    </label>
    <label class="g3-sel">Form (şekil)
      <select id="form">{groupedForms().map((g) => <optgroup label={g.grup}>{g.items.map((f) => <option value={f.id}>{f.ad}{f.dogrulanmali ? ' (doğrulanmalı)' : ''}</option>)}</optgroup>)}</select>
    </label>
    <label class="g3-chk"><input type="checkbox" id="swim" /> Yüzme animasyonu</label>
    <label class="g3-chk"><input type="checkbox" id="rot" /> Otomatik döndür</label>
    <label class="g3-chk"><input type="checkbox" id="hotspots" checked /> Numaraları göster</label>
  </div>
  <p class="muted g3-note" id="sexnote" aria-live="polite"></p>

  <div class="g3-stage" id="stage" data-sex="erkek" data-variant="mozaik" data-form="standart" data-swim="off" data-rotate="off" data-view="capraz">
    <canvas id="cv" tabindex="0" role="img" aria-describedby="g3-help"
      aria-label="Lepistesin etkileşimli 3B modeli. Ok tuşlarıyla döndürebilir, artı ve eksi tuşlarıyla yakınlaştırabilirsiniz."></canvas>
    <div class="g3-hotwrap" id="hot" data-pagefind-ignore></div>
    <p class="g3-status" id="status" role="status">3B model, görünür olunca yüklenecek…</p>
    <div class="g3-fallback" id="fallback" hidden>
      <p><strong>3B görüntü bu tarayıcıda açılamadı.</strong> WebGL desteklenmiyor ya da kapalı olabilir. Aşağıda şematik yan görünüş ve parça açıklamaları yer alıyor.</p>
      <div class="g3-figs">
        {figures.map((f) => (
          <figure>
            <svg viewBox={f.vb} role="img" aria-label={`${sexName[f.sex]} lepistes, yandan şematik çizim`} class="g3-svg">
              <path class="svg-tail" d={f.d.tail} />
              <path class="svg-fin" d={f.d.dorsal} />
              {f.d.anal && <path class="svg-fin" d={f.d.anal} />}
              <path class="svg-fin" d={f.d.pelvic} />
              <path class="svg-body" d={f.d.body} />
              <path class="svg-fin" d={f.d.pectoral} />
              {f.d.gono && <path class="svg-gono" d={f.d.gono} />}
              {f.s.spot && <ellipse class="svg-spot" cx={f.s.spot.x} cy={-f.s.spot.y} rx={f.s.spot.rx} ry={f.s.spot.ry} />}
              <circle class="svg-eye" cx={f.s.eye.x} cy={-f.s.eye.y} r={f.s.eye.r} />
              <circle class="svg-pupil" cx={f.s.eye.x} cy={-f.s.eye.y} r={f.s.eye.r * 0.5} />
            </svg>
            <figcaption>{sexName[f.sex]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
  <p class="muted" id="g3-help">Sürükleyin ya da ok tuşlarıyla döndürün; fare tekerleği, çimdik hareketi veya + / − tuşlarıyla yakınlaştırın; <kbd>0</kbd> görünümü sıfırlar. Sayfayı kaydırmak için modelin dışına dokunun. Hareket azaltma tercihiniz açıksa animasyonlar kapalı başlar.</p>
  <noscript><p class="callout callout-uyari">3B model için JavaScript gerekir. Parça açıklamaları aşağıda metin olarak da verilmiştir.</p></noscript>

  <div class="g3-bar" role="group" aria-label="Görünüm ve yakınlaştırma">
    <button type="button" class="g3-btn" data-view="yan">Yan</button>
    <button type="button" class="g3-btn" data-view="ust">Üst</button>
    <button type="button" class="g3-btn" data-view="on">Ön</button>
    <button type="button" class="g3-btn" data-view="arka">Arka</button>
    <button type="button" class="g3-btn" data-view="alt">Alt</button>
    <button type="button" class="g3-btn" data-view="capraz">Çapraz</button>
    <button type="button" class="g3-btn" id="zin" aria-label="Yakınlaştır">+</button>
    <button type="button" class="g3-btn" id="zout" aria-label="Uzaklaştır">−</button>
    <button type="button" class="g3-btn" id="zreset">Sıfırla</button>
  </div>

  <h2>Anatomi parçaları</h2>
  <div class="g3-info">
    <ul class="g3-parts" id="parts">
      {[...PARTS, ...FORM_PARTS].map((p) => (
        <li hidden={FORM_PARTS.includes(p)} data-part={p.id} data-sex={p.sex ?? ''}><button type="button" class="g3-part" aria-pressed="false" data-part={p.id}><span class="g3-n" aria-hidden="true"></span>{p.ad}</button></li>
      ))}
    </ul>
    <div class="g3-detail" id="detail" aria-live="polite">
      <p class="muted">Bir parça seçin: modelde numaralı noktaya ya da listeden bir öğeye tıklayın.</p>
    </div>
  </div>

  <details class="g3-all">
    <summary>Tüm parçaların metin açıklamaları</summary>
    <dl>
      {[...PARTS, ...FORM_PARTS].map((p) => (<><dt>{p.ad}{p.sex && <span class="muted"> ({sexName[p.sex].toLowerCase()})</span>}</dt><dd>{p.aciklama}{p.dogrulanmali && <> <em>(Kaynakla doğrulanmalı.)</em></>}</dd></>))}
    </dl>
  </details>

  <h2>Renk varyeteleri</h2>
  <p class="muted">{VARIANTS.length} şematik renk varyetesi; renk ve desen biçimden bağımsızdır, yukarıdaki "Form (şekil)" seçiminin her seçeneğiyle birleştirilebilir (desenli yüzgeçler seçilen kuyruk ve sırt yüzgecinin biçimini izler). Tanımlar hobi kaynaklarındaki ortak anlatımlara dayanan şematik yorumlardır; adlandırma ve renk tarifleri yetiştiriciye göre değişebilir.</p>
  {groupedVariants().map((g) => (<><h3>{g.grup}</h3><ul>{g.items.map((v) => <li><strong>{v.ad}:</strong> {v.aciklama}</li>)}</ul></>))}

  <h2>Form (şekil) varyeteleri</h2>
  <p class="muted">{FORMS.length} form; gövde aynı kalır, kuyruk, sırt ve göğüs yüzgeçlerinin biçimi değişir. Şekil adları ve oranlar hobi kaynaklarında farklı tanımlanabilir; "doğrulanmalı" işaretliler kaynaklar arasında ayrışan ya da şematik yorum içeren biçimlerdir.</p>
  {groupedForms().map((g) => (<><h3>{g.grup}</h3><ul>{g.items.map((f) => <li><strong>{f.ad}:</strong> {f.aciklama}{f.dogrulanmali && <> <em>(Doğrulanmalı.)</em></>}</li>)}</ul></>))}

  <div class="callout callout-bilgi">
    <strong>Bu model şematiktir.</strong> Oranlar ve renkler eğitim amaçlı bir yorumdur; gerçek bir balığın ölçüsü ya da yarışma standardı değildir. Erkek–dişi farkını ve anatomiyi anlamak için kullanın. Ayrıntılar: <a href="/wiki/gonopodium">Gonopodium</a>, <a href="/wiki/gravid-spot">Gravid spot</a>, <a href="/rehber/baslangic/01-lepistes-nedir">Lepistes nedir?</a>
  </div>
</Base>

<style is:global>
  .g3-bar{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;margin:14px 0}
  .g3-seg{display:flex;gap:6px;align-items:center;border:1px solid var(--line);border-radius:var(--r);padding:2px 10px 6px;margin:0;background:var(--card)}
  .g3-seg legend{font-size:.85rem;padding:0 4px;color:var(--muted)}
  .g3-seg label,.g3-chk{display:inline-flex;gap:6px;align-items:center;min-height:36px;padding:0 6px;cursor:pointer;font-weight:600}
  .g3-seg input,.g3-chk input{width:20px;height:20px;accent-color:var(--brand)}
  .g3-sel{display:grid;gap:2px;font-weight:600;font-size:.9rem}
  .g3-sel select{min-height:40px}
  .g3-note{margin:0 0 10px;min-height:1.6em;font-size:.92rem}
  .g3-btn{min-width:44px;min-height:40px;padding:6px 14px}
  .g3-btn[aria-pressed=true]{outline:3px solid var(--accent)}
  .g3-stage{position:relative;border-radius:var(--r);overflow:hidden;background:radial-gradient(120% 90% at 50% 20%,#1b7390 0%,#0d3f58 45%,#06202e 100%);border:1px solid var(--line);min-height:320px}
  .g3-stage canvas{display:block;width:100%;height:clamp(340px,64vh,580px);touch-action:none;cursor:grab;outline-offset:-4px}
  .g3-stage canvas:active{cursor:grabbing}
  .g3-stage[data-fallback] canvas,.g3-stage[data-fallback] .g3-hotwrap,.g3-stage[data-fallback] .g3-status{display:none}
  .g3-hotwrap{position:absolute;inset:0;pointer-events:none;overflow:hidden}
  .g3-hot{position:absolute;left:0;top:0;pointer-events:auto;width:26px;height:26px;padding:0;border-radius:50%;background:rgba(11,31,43,.82);color:#fff;border:2px solid #ffa94d;font-size:.72rem;font-weight:800;line-height:1;cursor:pointer;display:grid;place-items:center;will-change:transform}
  .g3-hot[hidden]{display:none}
  .g3-hot.on{background:#ffa94d;color:#0c1822;box-shadow:0 0 0 4px rgba(255,169,77,.35)}
  .g3-hot::after{content:attr(data-label);position:absolute;bottom:125%;left:50%;transform:translateX(-50%);white-space:nowrap;background:#0b1f2b;color:#fff;padding:2px 8px;border-radius:6px;font-size:.8rem;font-weight:600;opacity:0;pointer-events:none}
  .g3-hot:hover::after,.g3-hot.on::after{opacity:1}
  .g3-status{position:absolute;left:12px;bottom:8px;margin:0;color:#e6f3f8;font-size:.9rem;text-shadow:0 1px 2px #000}
  .g3-stage[data-ready] .g3-status{display:none}
  .g3-fallback{padding:16px;color:#e6f3f8}
  .g3-fallback a{color:#ffd29a}
  .g3-figs{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
  .g3-figs figure{margin:0;text-align:center}
  .g3-svg{width:100%;height:auto;max-height:260px}
  .g3-svg .svg-body{fill:#b9d3d8;stroke:#e6f3f8;stroke-width:.02}
  .g3-svg .svg-tail,.g3-svg .svg-fin{fill:rgba(255,169,77,.45);stroke:#ffd29a;stroke-width:.015}
  .g3-svg .svg-gono{fill:none;stroke:#e6f3f8;stroke-width:.05;stroke-linecap:round}
  .g3-svg .svg-spot{fill:#1a0f08;opacity:.8}
  .g3-svg .svg-eye{fill:#fff}.g3-svg .svg-pupil{fill:#000}
  .g3-info{display:grid;gap:16px;grid-template-columns:minmax(0,1fr);align-items:start}
  @media(min-width:760px){.g3-info{grid-template-columns:minmax(0,5fr) minmax(0,6fr)}}
  .g3-parts{list-style:none;margin:0;padding:0;display:grid;gap:6px}
  .g3-parts li[hidden]{display:none}
  .g3-part{width:100%;min-height:44px;text-align:left;display:flex;gap:10px;align-items:center;background:var(--card);color:var(--fg);border:1px solid var(--line);padding:6px 12px;font-weight:600}
  .g3-part[aria-pressed=true]{border-color:var(--accent);outline:2px solid var(--accent)}
  .g3-n{display:inline-grid;place-items:center;min-width:26px;height:26px;border-radius:50%;background:#0b1f2b;color:#fff;border:2px solid #ffa94d;font-size:.78rem;font-weight:800}
  .g3-detail{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:12px 16px;min-height:120px}
  .g3-detail h3{margin:.2em 0}
  .g3-detail .badge{color:var(--mid)}
  .g3-all{margin:14px 0}
  .g3-all summary{cursor:pointer;min-height:32px;font-weight:600}
  .g3-all dt{font-weight:700;margin-top:.6em}.g3-all dd{margin:0 0 .4em}
  @media (prefers-reduced-motion:no-preference){.g3-hot.on{animation:g3pulse 1.6s ease-in-out infinite}@keyframes g3pulse{50%{box-shadow:0 0 0 8px rgba(255,169,77,.1)}}}
</style>

<script>
  import { allPartsFor, partsFor, type PartId, type ViewId } from '../../lib/guppy/parts';
  import { variantById } from '../../lib/guppy/variants';
  import { formById } from '../../lib/guppy/forms';
  import type { Sex } from '../../lib/guppy/model';
  import type { Viewer } from '../../lib/guppy/viewer';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const stage = $('stage'), cv = $<HTMLCanvasElement>('cv'), hot = $('hot'), status = $('status'), fallback = $('fallback');
  const detail = $('detail'), sexnote = $('sexnote');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let sex: Sex = 'erkek';
  let form = 'standart';
  let selected: PartId | null = null;
  let viewer: Viewer | null = null;

  const notes: Record<Sex, string> = {
    erkek: 'Erkek: daha küçük ve ince gövde, uzun ve renkli sırt/kuyruk yüzgeci, anal yüzgecin yerinde gonopodium.',
    disi: 'Dişi: daha büyük ve yuvarlak gövde, kısa ve sönük yüzgeçler, yelpaze biçimli anal yüzgeç, karın arkasında gravid spot.',
  };

  function renderList() {
    const vis = partsFor(sex, form).map((p) => p.id);
    document.querySelectorAll<HTMLLIElement>('#parts li').forEach((li) => {
      const id = li.dataset.part as PartId;
      const i = vis.indexOf(id);
      li.hidden = i < 0;
      const n = li.querySelector('.g3-n');
      if (n && i >= 0) n.textContent = String(i + 1);
    });
  }

  function renderDetail() {
    detail.textContent = '';
    const p = allPartsFor(form).find((x) => x.id === selected);
    if (!p) {
      const m = document.createElement('p');
      m.className = 'muted';
      m.textContent = 'Bir parça seçin: modelde numaralı noktaya ya da listeden bir öğeye tıklayın.';
      detail.appendChild(m);
      return;
    }
    const h = document.createElement('h3');
    h.textContent = p.ad;
    const t = document.createElement('p');
    t.textContent = p.aciklama;
    detail.append(h, t);
    if (p.dogrulanmali) {
      const b = document.createElement('p');
      b.innerHTML = '<span class="badge">Kaynakla doğrulanmalı</span>';
      detail.appendChild(b);
    }
    if (p.wiki) {
      const a = document.createElement('a');
      a.href = `/wiki/${p.wiki}`;
      a.textContent = 'Wiki maddesini oku →';
      const w = document.createElement('p');
      w.appendChild(a);
      detail.appendChild(w);
    }
  }

  function select(id: PartId | null, fromList = false) {
    selected = id;
    stage.dataset.selected = id ?? '';
    document.querySelectorAll<HTMLButtonElement>('.g3-part').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.part === id)));
    renderDetail();
    viewer?.select(id);
    if (id && fromList && viewer && !viewer.isPartVisible(id)) viewer.setView('yan');
  }

  document.querySelectorAll<HTMLButtonElement>('.g3-part').forEach((b) => b.addEventListener('click', () => {
    const id = b.dataset.part as PartId;
    select(selected === id ? null : id, true);
  }));

  function setSex(s: Sex) {
    sex = s;
    stage.dataset.sex = s;
    sexnote.textContent = notes[s];
    if (selected && !partsFor(s, form).some((p) => p.id === selected)) select(null);
    renderList();
    viewer?.setSex(s);
  }
  document.querySelectorAll<HTMLInputElement>('input[name=sex]').forEach((r) => r.addEventListener('change', () => { if (r.checked) setSex(r.value as Sex); }));

  const variantSel = $<HTMLSelectElement>('variant');
  variantSel.addEventListener('change', () => {
    stage.dataset.variant = variantSel.value;
    viewer?.setVariant(variantSel.value);
    status.textContent = '';
    sexnote.textContent = `${notes[sex]} Varyete — ${variantById(variantSel.value).ad}: ${variantById(variantSel.value).aciklama}`;
  });

  const formSel = $<HTMLSelectElement>('form');
  formSel.addEventListener('change', () => {
    form = formSel.value;
    stage.dataset.form = form;
    if (selected && !partsFor(sex, form).some((p) => p.id === selected)) select(null); else renderDetail();
    renderList();
    viewer?.setForm(form);
    status.textContent = '';
    sexnote.textContent = `${notes[sex]} Form — ${formById(form).ad}: ${formById(form).aciklama}`;
  });

  const swim = $<HTMLInputElement>('swim'), rot = $<HTMLInputElement>('rot');
  swim.checked = !reduced;
  swim.addEventListener('change', () => { stage.dataset.swim = swim.checked ? 'on' : 'off'; viewer?.setSwim(swim.checked); });
  rot.addEventListener('change', () => { stage.dataset.rotate = rot.checked ? 'on' : 'off'; viewer?.setAutoRotate(rot.checked); });
  stage.dataset.swim = swim.checked ? 'on' : 'off';

  // Numaralı noktalar: tercih yalnızca bu tarayıcıda hatırlanır (localStorage yoksa varsayılan açık).
  const HS_KEY = 'lepistes-numaralar';
  const hs = $<HTMLInputElement>('hotspots');
  try { if (localStorage.getItem(HS_KEY) === 'off') hs.checked = false; } catch { /* depolama kapalı */ }
  const applyHs = () => { stage.dataset.hotspots = hs.checked ? 'on' : 'off'; viewer?.setHotspots(hs.checked); };
  hs.addEventListener('change', () => { applyHs(); try { localStorage.setItem(HS_KEY, hs.checked ? 'on' : 'off'); } catch { /* yok say */ } });
  stage.dataset.hotspots = hs.checked ? 'on' : 'off';

  document.querySelectorAll<HTMLButtonElement>('.g3-btn[data-view]').forEach((b) => b.addEventListener('click', () => {
    stage.dataset.view = b.dataset.view!;
    viewer?.setView(b.dataset.view as ViewId);
  }));
  $('zin').addEventListener('click', () => viewer?.zoom(0.8));
  $('zout').addEventListener('click', () => viewer?.zoom(1.25));
  $('zreset').addEventListener('click', () => { stage.dataset.view = 'capraz'; viewer?.reset(); });

  cv.addEventListener('keydown', (e) => {
    if (!viewer) return;
    const step = 0.16;
    const k = e.key;
    if (k === 'ArrowLeft') viewer.rotate(-step, 0);
    else if (k === 'ArrowRight') viewer.rotate(step, 0);
    else if (k === 'ArrowUp') viewer.rotate(0, -step);
    else if (k === 'ArrowDown') viewer.rotate(0, step);
    else if (k === '+' || k === '=') viewer.zoom(0.85);
    else if (k === '-' || k === '_') viewer.zoom(1.18);
    else if (k === '0' || k === 'Home') viewer.reset();
    else return;
    e.preventDefault();
  });

  function showFallback(msg?: string) {
    stage.setAttribute('data-fallback', '');
    fallback.hidden = false;
    status.textContent = msg ?? '';
  }

  function hasWebGL(): boolean {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch { return false; }
  }

  let started = false;
  async function start() {
    if (started) return;
    started = true;
    if (!hasWebGL()) { showFallback(); return; }
    status.textContent = '3B model yükleniyor…';
    try {
      const { createViewer } = await import('../../lib/guppy/viewer');
      viewer = createViewer({
        canvas: cv, overlay: hot, sex, variant: variantSel.value, form, reducedMotion: reduced,
        onSelect: (id) => select(id),
      });
      viewer.setSwim(swim.checked);
      viewer.setAutoRotate(rot.checked);
      viewer.setHotspots(hs.checked);
      if (selected) viewer.select(selected);
    } catch (err) {
      console.error(err);
      showFallback();
    }
  }

  setSex('erkek');
  renderDetail();
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((e) => { if (e.some((x) => x.isIntersecting)) { io.disconnect(); start(); } }, { rootMargin: '300px' });
    io.observe(stage);
  } else start();
</script>
