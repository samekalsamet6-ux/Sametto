---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Lepistes (guppy) üretimi için rehber, wiki ve yardımcı araçlar.' } = Astro.props;
const nav = [['/rehber','Rehber'],['/wiki','Wiki'],['/araclar','Araçlar'],['/ara','🔍 Ara'],['/kaynaklar','Kaynaklar'],['/hakkinda','Hakkında']];
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title} · Lepistes Rehberi</title>
  <meta name="description" content={description} />
</head>
<body>
  <header class="site"><div class="wrap">
    <a class="logo" href="/">🐟 Lepistes Rehberi</a>
    <nav>{nav.map(([h,t]) => <a href={h}>{t}</a>)}</nav>
  </div></header>
  <main class="wrap" data-pagefind-body><slot /></main>
  <footer><div class="wrap">
    Bilgiler eğitim amaçlıdır; ilaç ve tedavi için uzman görüşü alın. Lepistes asla doğaya salınmamalıdır.
  </div></footer>
</body>
</html>
