  <rect class="dg-box" x="270" y="272" width="190" height="70" rx="10" /><text class="dg-t" x="365" y="302" text-anchor="middle">Bakire dişi tankı</text><text class="dg-s" x="365" y="326" text-anchor="middle">erkekle hiç temas yok</text>

  <line class="dg-ar" x1="105" y1="344" x2="230" y2="396" marker-end="url(#td-ok)" />
  <line class="dg-ar" x1="365" y1="344" x2="270" y2="396" marker-end="url(#td-ok)" />
