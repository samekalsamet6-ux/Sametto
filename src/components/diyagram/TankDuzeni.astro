<svg class="dg" viewBox="0 0 640 470" role="img" aria-labelledby="td-t td-d">
  <title id="td-t">Üretim tank sistemi şeması</title>
  <desc id="td-d">Yeni balıklar önce karantina tankına girer, sağlıklıysa ana yetişkin tankına geçer. Gebe dişiler doğum tankına, yavrular yavru büyütme tankına alınır. Yavrulardan erkekler ve bakire dişiler ayrı tanklara ayrılır; seçilmiş bireyler planlı çiftleşme tankında buluşur.</desc>
  <defs><marker id="td-ok" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="currentColor" /></marker></defs>

  <rect class="dg-box" x="10" y="10" width="190" height="70" rx="10" /><text class="dg-t" x="105" y="40" text-anchor="middle">Karantina</text><text class="dg-s" x="105" y="64" text-anchor="middle">yeni / hasta balık</text>
  <line class="dg-ar" x1="202" y1="45" x2="268" y2="45" marker-end="url(#td-ok)" />
  <text class="dg-s" x="235" y="36" text-anchor="middle">sağlıklı</text>
  <rect class="dg-box dg-ok" x="270" y="10" width="190" height="70" rx="10" /><text class="dg-t" x="365" y="40" text-anchor="middle">Ana tank</text><text class="dg-s" x="365" y="64" text-anchor="middle">yetişkin grubu</text>

  <line class="dg-ar" x1="365" y1="82" x2="365" y2="128" marker-end="url(#td-ok)" />
  <text class="dg-s" x="380" y="112">gebe dişi</text>
  <rect class="dg-box" x="270" y="132" width="190" height="70" rx="10" /><text class="dg-t" x="365" y="162" text-anchor="middle">Doğum tankı</text><text class="dg-s" x="365" y="186" text-anchor="middle">yoğun bitki</text>

  <line class="dg-ar" x1="272" y1="167" x2="212" y2="167" marker-end="url(#td-ok)" />
  <text class="dg-s" x="236" y="150" text-anchor="middle">yavrular</text>
  <rect class="dg-box" x="10" y="132" width="190" height="70" rx="10" /><text class="dg-t" x="105" y="162" text-anchor="middle">Yavru büyütme</text><text class="dg-s" x="105" y="186" text-anchor="middle">cinsiyet ayrımı öncesi</text>

  <line class="dg-ar" x1="60" y1="204" x2="60" y2="268" marker-end="url(#td-ok)" />
