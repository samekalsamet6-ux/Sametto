  </g>
  <line class="dg-ar" x1="150" y1="290" x2="204" y2="228" />
  <text class="dg-s" x="150" y="316" text-anchor="middle">gonopodium: uzun, ince</text>
  <text class="dg-s" x="150" y="338" text-anchor="middle">çubuk biçimli üreme organı</text>

  <text class="dg-t" x="480" y="26" text-anchor="middle">Dişi</text>
