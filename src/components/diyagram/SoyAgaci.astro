<svg class="dg" viewBox="0 0 640 400" role="img" aria-labelledby="sa-t sa-d">
  <title id="sa-t">Tam kardeş çiftleşmesi soy ağacı</title>
  <desc id="sa-d">S baba ve M anadan iki tam kardeş, A ve B doğar. A ile B çiftleştirilirse yavrunun inbreeding katsayısı F 0,25 olur, çünkü iki ortak ata (S ve M) vardır ve her biri 0,125 katkı yapar.</desc>
  <rect class="dg-box" x="140" y="14" width="130" height="56" rx="10" /><text class="dg-t" x="205" y="48" text-anchor="middle">S (baba)</text>
  <rect class="dg-box" x="370" y="14" width="130" height="56" rx="10" /><text class="dg-t" x="435" y="48" text-anchor="middle">M (anne)</text>
  <line class="dg-ln" x1="270" y1="42" x2="370" y2="42" />
  <line class="dg-ln" x1="320" y1="42" x2="320" y2="130" />
  <line class="dg-ln" x1="205" y1="130" x2="435" y2="130" />
  <line class="dg-ln" x1="205" y1="130" x2="205" y2="160" />
  <line class="dg-ln" x1="435" y1="130" x2="435" y2="160" />
  <rect class="dg-box" x="140" y="160" width="130" height="56" rx="10" /><text class="dg-t" x="205" y="194" text-anchor="middle">A</text>
  <rect class="dg-box" x="370" y="160" width="130" height="56" rx="10" /><text class="dg-t" x="435" y="194" text-anchor="middle">B</text>
  <line class="dg-ln dg-dash" x1="270" y1="188" x2="370" y2="188" />
  <text class="dg-s" x="320" y="178" text-anchor="middle">A × B</text>
  <line class="dg-ar" x1="320" y1="190" x2="320" y2="262" marker-end="url(#sa-ok)" />
  <defs><marker id="sa-ok" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="currentColor" /></marker></defs>
  <rect class="dg-box dg-hl" x="215" y="266" width="210" height="56" rx="10" /><text class="dg-t" x="320" y="300" text-anchor="middle">Yavru: F = 0,25</text>
  <text class="dg-s" x="320" y="350" text-anchor="middle">F = Σ (1/2)^(n1+n2+1) → 2 ortak ata × (1/2)³ = 0,25</text>
  <text class="dg-s" x="320" y="376" text-anchor="middle">Akraba olmayan bireylerde F = 0.</text>
