<svg class="dg" viewBox="0 0 640 600" role="img" aria-labelledby="azot-t azot-d">
  <title id="azot-t">Azot döngüsü akış şeması</title>
  <desc id="azot-d">Balık atıkları ve artık yemden amonyak oluşur; faydalı bakteriler amonyağı nitrite, sonra nitrata çevirir; nitrat su değişimi ve bitkilerle sistemden uzaklaşır.</desc>
  <defs><marker id="azot-ok" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="currentColor" /></marker></defs>

  <rect class="dg-box" x="130" y="10" width="380" height="76" rx="12" />
  <text class="dg-t" x="320" y="42" text-anchor="middle">Balık atıkları + artık yem</text>
  <text class="dg-s" x="320" y="68" text-anchor="middle">solunum, dışkı, çürüyen organik madde</text>

  <line class="dg-ar" x1="320" y1="88" x2="320" y2="130" marker-end="url(#azot-ok)" />

  <rect class="dg-box dg-bad" x="130" y="134" width="380" height="76" rx="12" />
  <text class="dg-t" x="320" y="166" text-anchor="middle">Amonyak (NH3 / NH4)</text>
  <text class="dg-s" x="320" y="192" text-anchor="middle">⚠ zehirli — olgun tankta ölçüm 0</text>

  <line class="dg-ar" x1="320" y1="212" x2="320" y2="254" marker-end="url(#azot-ok)" />
  <text class="dg-s" x="336" y="238">faydalı bakteriler (1. aşama)</text>

  <rect class="dg-box dg-bad" x="130" y="258" width="380" height="76" rx="12" />
  <text class="dg-t" x="320" y="290" text-anchor="middle">Nitrit (NO2)</text>
  <text class="dg-s" x="320" y="316" text-anchor="middle">⚠ zehirli — olgun tankta ölçüm 0</text>

  <line class="dg-ar" x1="320" y1="336" x2="320" y2="378" marker-end="url(#azot-ok)" />
  <text class="dg-s" x="336" y="362">faydalı bakteriler (2. aşama)</text>

  <rect class="dg-box dg-ok" x="130" y="382" width="380" height="76" rx="12" />
  <text class="dg-t" x="320" y="414" text-anchor="middle">Nitrat (NO3)</text>
  <text class="dg-s" x="320" y="440" text-anchor="middle">daha az zehirli — zamanla birikir</text>

  <line class="dg-ar" x1="320" y1="460" x2="320" y2="502" marker-end="url(#azot-ok)" />

  <rect class="dg-box" x="130" y="506" width="380" height="76" rx="12" />
  <text class="dg-t" x="320" y="538" text-anchor="middle">Kısmi su değişimi + bitkiler</text>
  <text class="dg-s" x="320" y="564" text-anchor="middle">nitratı sistemden uzaklaştırır</text>
</svg>
